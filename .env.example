# Copy to .env and fill in. The dashboard runs fine without these; only the
# AI hover insights are disabled when OPENROUTER_API_KEY is absent.

# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional. Defaults to minimax/minimax-m3:free.
# Free-tier accounts can only call model ids ending in ":free" and are capped at
# a few dozen requests per day -- see MAX_CALLS_PER_PROCESS in ai_analyzer.py.
OPENROUTER_MODEL=minimax/minimax-m3:free
